# Backend Environment Variables
# Copy this file to .env.backend and update values for your environment

NODE_ENV=development
PORT=4000

# Database Configuration
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=gis
DATABASE_USER=gis_dev
DATABASE_PASSWORD=gis_dev_password
DATABASE_URL=postgresql://gis_dev:gis_dev_password@db:5432/gis # Note: Internal docker port is 5432. Use 5434 for manual host connections.

# Security
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug
